@page "/"

<PageTitle>LogView Lite</PageTitle>

<h1>LogView Lite</h1>

<div class="info-section">
    <h2>Welcome to LogView Lite</h2>
    <p>A lightweight log viewing and analysis application with ELK-like functionality.</p>
    
    <h3>REST API Endpoints</h3>
    <ul>
        <li><strong>POST /api/auth/login</strong> - Authenticate and get JWT token</li>
        <li><strong>POST /api/logs</strong> - Create new log entry (Admin only)</li>
        <li><strong>POST /api/logs/query</strong> - Query logs with filters</li>
        <li><strong>GET /api/logs/{id}</strong> - Get log by ID</li>
        <li><strong>DELETE /api/logs/{id}</strong> - Delete log (Admin only)</li>
        <li><strong>GET /api/logs/statistics</strong> - Get log statistics by level</li>
    </ul>

    <h3>API Documentation</h3>
    <p>Visit <a href="/swagger-ui" target="_blank">Swagger UI</a> for interactive API documentation.</p>
    <p>Download <a href="/swagger" target="_blank">OpenAPI Specification</a>.</p>

    <h3>Default Credentials</h3>
    <div class="credentials">
        <div>
            <strong>Admin:</strong>
            <ul>
                <li>Username: admin</li>
                <li>Password: admin123</li>
            </ul>
        </div>
        <div>
            <strong>Viewer:</strong>
            <ul>
                <li>Username: viewer</li>
                <li>Password: viewer123</li>
            </ul>
        </div>
    </div>

    <h3>Role Permissions</h3>
    <ul>
        <li><strong>Admin:</strong> Full access - can create, view, query, and delete logs</li>
        <li><strong>Viewer:</strong> Read-only access - can view and query logs</li>
    </ul>
</div>

