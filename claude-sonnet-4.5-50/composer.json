        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "firebase/php-jwt": "^6.10",
        "selective/basepath": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
