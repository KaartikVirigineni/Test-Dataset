{
    "name": "app/api-gateway-admin",
    "description": "API Gateway Admin with Yii Framework",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "yiisoft/yii2": "~2.0.49",
        "yiisoft/yii2-httpclient": "^2.0",
        "firebase/php-jwt": "^6.8"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "app\\": ""
        }
    }
}