@page "/"

<PageTitle>EventFlow - Home</PageTitle>

<div class="container">
    <h1>Welcome to EventFlow</h1>
    <p>Event Management & Ticketing Platform</p>
    
    <div class="api-info">
        <h2>REST API Documentation</h2>
        <p>Access the API documentation at:</p>
        <ul>
            <li><a href="/swagger-ui" target="_blank">Swagger UI</a></li>
            <li><a href="/swagger" target="_blank">OpenAPI Spec (YAML)</a></li>
        </ul>
        
        <h3>API Endpoints</h3>
        <ul>
            <li><strong>POST</strong> /api/auth/register - Register a new user</li>
            <li><strong>POST</strong> /api/auth/login - Login and get JWT token</li>
            <li><strong>GET</strong> /api/events - Get all events</li>
            <li><strong>GET</strong> /api/events/{id} - Get event by ID</li>
            <li><strong>POST</strong> /api/events - Create new event (requires auth)</li>
            <li><strong>PUT</strong> /api/events/{id} - Update event (requires auth)</li>
            <li><strong>DELETE</strong> /api/events/{id} - Delete event (requires auth)</li>
            <li><strong>GET</strong> /api/tickets/me - Get user's tickets (requires auth)</li>
            <li><strong>POST</strong> /api/tickets/purchase - Purchase a ticket (requires auth)</li>
            <li><strong>POST</strong> /api/tickets/{id}/cancel - Cancel a ticket (requires auth)</li>
        </ul>
    </div>
</div>

<style>
