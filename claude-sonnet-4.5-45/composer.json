{
    "name": "devportal/app",
    "description": "Developer Portal with REST and GraphQL",
    "type": "project",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.4",
        "firebase/php-jwt": "^6.10",
        "webonyx/graphql-php": "^15.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php spark cache:clear"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}